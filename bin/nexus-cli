#!/usr/bin/env python3
"""nexus-cli — the Nexus backend. The code lives in the nexus/cli/ package; this stub imports it so
Python caches its bytecode instead of recompiling it on every run."""
import sys
from pathlib import Path

if not sys.platform.startswith("linux"):
    sys.exit("Nexus runs on Linux only (it runs Windows games through Proton/Wine).\n"
             "On Windows, see docs/WINDOWS.md in the Nexus folder.")
if sys.version_info < (3, 11):
    sys.exit(f"Nexus needs Python 3.11 or newer (this is {sys.version.split()[0]}).")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))   # may be symlinked
from nexus.cli import main  # noqa: E402

main()
